{
  "name": "structured-vibe-coding",
  "private": true,
  "version": "0.16.2",
  "description": "sdd — local Spec-Driven Development CLI for AI coding agents (hotfix, greenfield, enterprise ARB)",
  "keywords": [
    "sdd",
    "spec-driven-development",
    "structured-vibe-coding",
    "ai-coding",
    "ai-coding-agent",
    "local-sdd",
    "greenfield",
    "cli",
    "copilot",
    "claude-code",
    "grok",
    "ollama"
  ],
  "homepage": "https://harsha09.github.io/spec-driven-development/",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "lint": "biome check packages/core/src packages/cli/src",
    "lint:fix": "biome check packages/core/src packages/cli/src --write",
    "format": "biome format packages/core/src packages/cli/src --write",
    "typecheck": "pnpm -r run typecheck",
    "sdd": "pnpm --filter @structured-vibe-coding/cli exec node ./dist/index.js",
    "publish:npm": "pnpm build && pnpm test && pnpm --filter @structured-vibe-coding/core publish --access public && pnpm --filter @structured-vibe-coding/cli publish --access public",
    "publish:npm:dry": "pnpm --filter @structured-vibe-coding/core publish --dry-run --no-git-checks && pnpm --filter @structured-vibe-coding/cli publish --dry-run --no-git-checks",
    "version:bump": "node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/docs-pages-layout.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsha09/spec-driven-development.git"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "^9.1.7",
    "vite": "6.4.3",
    "vitepress": "^1.6.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9",
      "tsup>esbuild": "0.28.1",
      "bundle-require>esbuild": "0.28.1",
      "vite": "6.4.3"
    }
  }
}
