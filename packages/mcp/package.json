{
  "name": "@structured-vibe-coding/mcp",
  "version": "0.13.0",
  "description": "MCP server for sdd AST code context — on-demand slices so agents pull less code into the prompt",
  "type": "module",
  "bin": {
    "sdd-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "pnpm --filter @structured-vibe-coding/core run build && pnpm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@structured-vibe-coding/core": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsha09/spec-driven-development.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://harsha09.github.io/spec-driven-development/guides/code-context",
  "bugs": {
    "url": "https://github.com/harsha09/spec-driven-development/issues"
  },
  "keywords": [
    "sdd",
    "mcp",
    "model-context-protocol",
    "ast",
    "code-context",
    "spec-driven-development",
    "ai-coding"
  ]
}
