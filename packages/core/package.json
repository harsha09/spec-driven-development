{
  "name": "@structured-vibe-coding/core",
  "version": "0.16.2",
  "description": "Core engine for sdd — Spec-Driven Development workflows, change packs, greenfield, and AI agent handoff (used by the sdd CLI)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "defaults",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && biome check packages/core/src",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pathe": "^2.0.3",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsha09/spec-driven-development.git",
    "directory": "packages/core"
  },
  "homepage": "https://harsha09.github.io/spec-driven-development/",
  "bugs": {
    "url": "https://github.com/harsha09/spec-driven-development/issues"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "spec-driven-development-cli",
    "structured-vibe-coding",
    "ai-coding",
    "ai-coding-agent",
    "ai-agent-workflow",
    "agent-handoff",
    "workflow",
    "greenfield",
    "change-packs",
    "change-pack",
    "local-sdd"
  ]
}
